# Puerto del servidor de la API
PORT=3000

# Conexión a PostgreSQL (desarrollo local)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=tnc_app
# Rellenar con la contraseña del usuario tnc_app
DATABASE_PASSWORD=
DATABASE_NAME=tnc_discordgang

# Entorno: development | production (controla synchronize de TypeORM)
NODE_ENV=development

# API Key compartida con el bot (header x-api-key) para endpoints internos
API_KEY=

# OAuth de Discord (login para la futura web)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/v1/auth/discord/callback

# ID del servidor de Discord (guild) para roles y miembros de la web
DISCORD_GUILD_ID=

# URL de la futura página web (CORS y redirect tras login)
FRONTEND_URL=http://localhost:5173

# JWT para la sesión de la web
JWT_SECRET=
JWT_EXPIRES_IN=1d
